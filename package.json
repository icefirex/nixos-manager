{
  "name": "nixos-manager",
  "version": "1.5.7",
  "description": "A beautiful GUI for managing NixOS configurations",
  "author": "icefirex",
  "repository": {
    "type": "git",
    "url": "https://github.com/icefirex/nixos-manager.git"
  },
  "homepage": "https://github.com/icefirex/nixos-manager",
  "bugs": {
    "url": "https://github.com/icefirex/nixos-manager/issues"
  },
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:svelte\" \"npm run dev:electron\"",
    "dev:svelte": "vite",
    "dev:electron": "wait-on http://localhost:5173 && ELECTRON_ENABLE_LOGGING=true electron .",
    "build": "vite build && electron-builder",
    "build:svelte": "vite build",
    "start": "electron ."
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.nixos.manager",
    "productName": "NixOS Manager",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "System"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.9.0",
    "lucide-svelte": "^0.577.0"
  }
}
