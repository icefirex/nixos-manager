{
  "name": "nixos-manager",
  "version": "1.9.0",
  "description": "A beautiful GUI for managing NixOS configurations",
  "author": "icefirex",
  "repository": {
    "type": "git",
    "url": "https://github.com/icefirex/nixos-manager.git"
  },
  "homepage": "https://github.com/icefirex/nixos-manager",
  "bugs": {
    "url": "https://github.com/icefirex/nixos-manager/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:svelte\" \"npm run dev:electron\"",
    "dev:svelte": "vite",
    "dev:electron": "npm run build:main && wait-on http://localhost:5173 && ELECTRON_ENABLE_LOGGING=true electron .",
    "build:main": "tsc -p tsconfig.build.json",
    "build": "npm run build:main && vite build && electron-builder",
    "build:svelte": "vite build",
    "start": "npm run build:main && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "io.github.icefirex.nixos-manager",
    "productName": "NixOS Manager",
    "icon": "assets/icon.svg",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "System;Settings;PackageManager;",
      "executableName": "nixos-manager"
    },
    "deb": {
      "depends": [],
      "maintainer": "icefirex <1530893+icefirex@users.noreply.github.com>"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.9.0",
    "lucide-svelte": "^0.577.0"
  }
}
